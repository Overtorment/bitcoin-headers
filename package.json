{
  "name": "bitcoin-headers",
  "version": "0.0.1",
  "description": "Isomorphic Bitcoin header PoW and chain-consensus validation for TypeScript",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "react-native": "./src/react-native.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "README.md"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean --sourcemap --target es2022 && tsup --config tsup.react-native.config.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "test:package": "bun tests/package/package-smoke.mjs",
    "check": "bun run typecheck && bun test && bun run test:package"
  },
  "dependencies": {
    "@noble/hashes": "^2.2.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
