{
  "name": "bitcoin-headers",
  "version": "0.0.1",
  "description": "Isomorphic Bitcoin header PoW and chain-consensus validation for TypeScript",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "react-native": "./dist/react-native.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean --sourcemap --target es2022 && tsup --config tsup.react-native.config.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "test:package": "npm run build && node tests/package/package-smoke.mjs",
    "check": "bun run typecheck && bun test && bun run test:package",
    "prepare": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "@noble/hashes": "^2.2.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
